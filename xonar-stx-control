#!/usr/bin/env python3
"""Xonar Essence STX Control Panel — Launch script"""

import sys
import os

# Allow running from source directory
script_dir = os.path.dirname(os.path.abspath(__file__))
if os.path.isdir(os.path.join(script_dir, "xonar_stx")):
    sys.path.insert(0, script_dir)

from xonar_stx.gui import XonarSTXApp


def main():
    app = XonarSTXApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
